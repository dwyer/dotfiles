# Environment shared by bash and zsh. Sourced by ~/.bashrc and ~/.zshrc,
# never by sh -- ~/.profile is left to the system.

# editor
export EDITOR=vim

# pager
export PAGER=less
export LESSHISTFILE=/dev/null

# Prepend a directory to PATH, skipping it if missing or already present.
path_prepend() {
    [ -d "$1" ] || return 0
    case ":${PATH}:" in
        *":$1:"*) ;;
        *) PATH="$1:${PATH}" ;;
    esac
}

# Machine-local environment: per-host paths and anything an installer wants to
# inject. path_prepend is still defined here, so this file may use it.
if [ -f "$HOME/.shrc.local" ]; then
    . "$HOME/.shrc.local"
fi

path_prepend "$HOME/bin"
path_prepend "$HOME/.local/bin"
export PATH
unset -f path_prepend
